{
  "name": "@control-weight/app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Aplicación PWA/Android de registro de peso e IMC. Los datos nunca salen del dispositivo.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:mirar": "vitest",
    "test:cobertura": "vitest run --coverage",
    "apk": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "android:sync": "npm run build && npx cap sync android",
    "android:studio": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
